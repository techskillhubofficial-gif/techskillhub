export default function GrowthNetworkJoinPage() {
  const [memberType, setMemberType] =
    useState<MemberType>("EXECUTIVE");
  const [referralCode, setReferralCode] = useState("");
  const [submitted, setSubmitted] = useState(false);
  const [applicationNo, setApplicationNo] = useState("");
  const [error, setError] = useState("");
  const [loading, setLoading] = useState(false);
  const [activeSection, setActiveSection] = useState("role");

  useEffect(() => {
    const params = new URLSearchParams(window.location.search);
    const ref = params.get("ref")?.trim();

    if (ref) {
      setReferralCode(ref);
    }
  }, []);

  useEffect(() => {
    const observers: IntersectionObserver[] = [];

    sections.forEach(([id]) => {
      const element = document.getElementById(id);

      if (!element) return;

      const observer = new IntersectionObserver(
        ([entry]) => {
          if (entry.isIntersecting) {
            setActiveSection(id);
          }
        },
        {
          rootMargin: "-20% 0px -65% 0px",
          threshold: 0,
        }
      );

      observer.observe(element);
      observers.push(observer);
    });

    return () => {
      observers.forEach((observer) => observer.disconnect());
    };
  }, []);

  function scrollToSection(id: string) {
    document.getElementById(id)?.scrollIntoView({
      behavior: "smooth",
      block: "start",
    });
  }

  async function handleSubmit(event: FormEvent<HTMLFormElement>) {
    event.preventDefault();
    setError("");
    setLoading(true);

    const form = new FormData(event.currentTarget);

    const responsibilitiesAccepted =
      form.get("responsibilitiesAccepted") === "on";
    const declarationsAccepted =
      form.get("declarationsAccepted") === "on";
    const marketingPolicyAccepted =
      form.get("marketingPolicyAccepted") === "on";
    const termsAccepted = form.get("termsAccepted") === "on";

    if (
      !responsibilitiesAccepted ||
      !declarationsAccepted ||
      !marketingPolicyAccepted ||
      !termsAccepted
    ) {
      setError("Please accept all required declarations before submitting.");
      setLoading(false);
      return;
    }

    const payload = {
      memberType,
      name: String(form.get("name") || "").trim(),
      email: String(form.get("email") || "").trim(),
      phone: String(form.get("phone") || "").trim(),
      city: String(form.get("city") || "").trim() || undefined,
      state: String(form.get("state") || "").trim() || undefined,
      education:
        String(form.get("education") || "").trim() || undefined,
      occupation:
        String(form.get("occupation") || "").trim() || undefined,
      organization:
        String(form.get("organization") || "").trim() || undefined,
      experience:
        String(form.get("experience") || "").trim() || undefined,
      availability:
        String(form.get("availability") || "").trim() || undefined,
      workingMode:
        String(form.get("workingMode") || "").trim() || undefined,
      leadershipExperience:
        String(form.get("leadershipExperience") || "").trim() || undefined,
      previousTeamSize:
        String(form.get("previousTeamSize") || "").trim() || undefined,
      expectedTeamSize:
        String(form.get("expectedTeamSize") || "").trim() || undefined,
      linkedinUrl:
        String(form.get("linkedinUrl") || "").trim() || undefined,
      instagramUrl:
        String(form.get("instagramUrl") || "").trim() || undefined,
      portfolioUrl:
        String(form.get("portfolioUrl") || "").trim() || undefined,
      responsibilitiesAccepted,
      declarationsAccepted,
      marketingPolicyAccepted,
      termsAccepted,
      ref:
        String(form.get("ref") || "").trim() ||
        referralCode ||
        undefined,
    };

    try {
      const response = await fetch("/api/tgn/applications", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify(payload),
      });

      const result = await response.json();

      if (!response.ok) {
        setError(result.message || "Unable to submit your application.");
        return;
      }

      setApplicationNo(result.application?.applicationNo || "");
      setSubmitted(true);
      window.scrollTo({ top: 0, behavior: "smooth" });
    } catch (submitError) {
      console.error("TGN application submission error:", submitError);
      setError("Unable to submit the application. Please try again.");
    } finally {
      setLoading(false);
    }
  }

