    event.preventDefault();
    setError("");

    if (
      !form.name.trim() ||
      !form.email.trim() ||
      !form.phone.trim()
    ) {
      setError("Please complete your name, email and phone number.");
      return;
    }

    if (
      !form.responsibilitiesAccepted ||
      !form.declarationsAccepted ||
      !form.marketingPolicyAccepted ||
      !form.termsAccepted
    ) {
      setError("Please accept all required declarations before submitting.");
      return;
    }

    setSubmitting(true);

    try {
      const response = await fetch("/api/tgn/applications", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          memberType,
          name: form.name.trim(),
          email: form.email.trim(),
          phone: form.phone.trim(),
          city: form.city.trim(),
          state: form.state.trim(),
          education: form.education.trim(),
          occupation: form.occupation.trim(),
          organization: form.organization.trim(),
          experience: form.experience.trim(),
          availability: form.availability.trim(),
          workingMode: form.workingMode,
          leadershipExperience: form.leadershipExperience.trim(),
          previousTeamSize: form.previousTeamSize
            ? Number(form.previousTeamSize)
            : undefined,
          expectedTeamSize: form.expectedTeamSize
            ? Number(form.expectedTeamSize)
            : undefined,
          linkedinUrl: form.linkedinUrl.trim(),
          instagramUrl: form.instagramUrl.trim(),
          portfolioUrl: form.portfolioUrl.trim(),
          ref: form.ref.trim() || undefined,
          responsibilitiesAccepted: form.responsibilitiesAccepted,
          declarationsAccepted: form.declarationsAccepted,
          marketingPolicyAccepted: form.marketingPolicyAccepted,
          termsAccepted: form.termsAccepted,
        }),
      });

      const data = await response.json();

      if (!response.ok) {
        throw new Error(
          data?.error || "We could not submit your application."
        );
      }

      setSubmitted(true);
      window.scrollTo({ top: 0, behavior: "smooth" });
    } catch (submitError) {
      setError(
        submitError instanceof Error
          ? submitError.message
          : "Something went wrong. Please try again."
      );
